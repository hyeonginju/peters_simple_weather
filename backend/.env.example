# 기상청 오픈 API 서비스 키 (data.go.kr 발급). 앱의 .env와 동일한 값.
KMA_SERVICE_KEY=

# 서버 포트 (Render는 PORT를 자동 주입하므로 비워두면 됨)
PORT=8080

# /internal/poll-alerts 호출 시 x-poll-secret 헤더로 제시해야 하는 공유 비밀.
# 임의의 긴 랜덤 문자열로 직접 채울 것 (예: openssl rand -hex 32).
POLL_SECRET=

# Firebase 서비스 계정 (FCM 푸시 발송용). 둘 중 하나로 설정:
#  - 배포(Render): 다운로드한 service-account.json 내용을 그대로 한 줄로 붙여넣기
#  - 로컬: 비워두면 backend/.secrets/service-account.json 파일을 자동으로 읽음
FIREBASE_SERVICE_ACCOUNT=
